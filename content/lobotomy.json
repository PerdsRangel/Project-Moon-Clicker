    "angela": {
    "name": "Angela",
    "image": "angela.webp",
    "lines": [
      { "id": "start", "when": "start", "text": [
        "Bem-vindo à Lobotomy Corporation, {jogador}.",
        "Nosso trabalho é simples: extrair Enkephalin das Abnormalidades. Comece suprimindo a primeira delas."
      ] },
      { "id": "clear-5", "when": "clear", "stage": 5, "text": "Seu primeiro chefe de contenção foi derrotado. Um começo aceitável." },
      { "id": "clear-10", "when": "clear", "stage": 10, "text": [
        "Dez fases concluídas. A Equipe de Treinamento agora está à sua disposição.",
        "Também autorizei o uso do E.G.O Equipment. Use-o quando precisar de dano extra."
      ] },
      { "id": "clear-35", "when": "clear", "stage": 35, "text": "Greed foi liberada. Enkephalin extra para a empresa. E para você." },
      { "id": "clear-50", "when": "clear", "stage": 50, "text": "A Equipe Coelho está autorizada a entrar em campo. Não a deixe esperando." },
      { "id": "raid-1", "when": "raid_win", "count": 1, "text": "Uma Raid concluída. As Caixas de Enkephalin Raid podem ser trocadas na loja da Raid." },
      { "id": "drop-1", "when": "drop", "text": "Um equipamento foi extraído. Estar bem equipado também faz parte do trabalho." },
      { "id": "dept-1", "when": "dept", "text": "Os departamentos aguardam suas ordens. Os pontos vêm do progresso, então gaste-os com sabedoria." },
      { "id": "clear-100", "when": "clear", "stage": 100, "text": [
        "Cem fases. Todas as Abnormalidades foram contidas.",
        "A Lobotomy Corporation agradece, {jogador}. Por enquanto."
      ] }
    ]
  },

